# ── Site ────────────────────────────────────────────────────────────────
# Production URL, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Public business details (each one is only shown when set) ──────────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Free text, e.g. "Remote-first · working with clients worldwide". Never list an office that doesn't exist.
NEXT_PUBLIC_CONTACT_LOCATION=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_TWITTER_HANDLE=

# ── Booking ─────────────────────────────────────────────────────────────
# Cal.com / Calendly link. When empty, "Book a Consultation" opens the consultation form instead.
NEXT_PUBLIC_BOOKING_URL=

# ── Lead delivery (server-only secrets — never prefix with NEXT_PUBLIC_) ─
# Option A: email via Resend (https://resend.com). LEADS_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=
# Option B: webhook to a CRM / Slack / HubSpot / n8n / Zapier. Receives JSON.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
# Max submissions per IP per 10 minutes (best-effort, per server instance).
LEADS_RATE_LIMIT_MAX=5
# Development/testing only: log leads to the server console instead of delivering them.
# In production with no channel configured, submissions FAIL visibly rather than being silently lost.
ALLOW_LOG_ONLY_LEADS=false

# ── Analytics & Search Console (optional) ───────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
